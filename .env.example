# ============================================
# agric-satellite-analysis / 农业卫星分析
# Environment Variables
# Copy to .env and fill in values. Never commit .env.
# Based on OpenFarm (https://github.com/superzero11/OpenFarm)
# ============================================

# --- Postgres ---
POSTGRES_USER=openfarm
POSTGRES_PASSWORD=openfarm_dev
POSTGRES_DB=openfarm
DATABASE_URL=postgresql+asyncpg://openfarm:openfarm_dev@db:5432/openfarm
# Sync URL for Alembic migrations
DATABASE_URL_SYNC=postgresql://openfarm:openfarm_dev@db:5432/openfarm

# --- Redis ---
REDIS_URL=redis://redis:6379/0


# --- Object storage backend (oss | minio) ---
# Default: Aliyun OSS for all uploads (COGs, photos, etc.).
# Local MinIO is opt-in: docker compose --profile minio up  and
# STORAGE_BACKEND=minio (plus TILER_* pointing at minio:9000).
# Never commit real OSS secrets — wire via host env / private .env.
STORAGE_BACKEND=oss

# --- Aliyun OSS (default primary backend + parcel products) ---
# Leave secrets empty in this example; load from a private env file at runtime.
OSS_REGION=oss-cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=agric-dev
# Fixed S1/S2 parcel product JSON directory
OSS_PREFIX=s1s2_parcel/json/

# TiTiler / GDAL S3-compatible access to OSS (defaults match Beijing OSS).
# For MinIO profile overrides:
#   TILER_S3_ENDPOINT=minio:9000 TILER_AWS_VIRTUAL_HOSTING=FALSE TILER_AWS_HTTPS=NO
#   TILER_AWS_ACCESS_KEY_ID=$MINIO_ACCESS_KEY TILER_AWS_SECRET_ACCESS_KEY=$MINIO_SECRET_KEY
TILER_S3_ENDPOINT=oss-cn-beijing.aliyuncs.com
# Optional overrides; empty → compose falls back to OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET.
TILER_AWS_ACCESS_KEY_ID=
TILER_AWS_SECRET_ACCESS_KEY=
TILER_AWS_VIRTUAL_HOSTING=TRUE
TILER_AWS_HTTPS=YES

# --- MinIO (optional; compose profile "minio") ---
MINIO_ROOT_USER=openfarm
MINIO_ROOT_PASSWORD=openfarm_dev_secret
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=openfarm
MINIO_SECRET_KEY=openfarm_dev_secret
MINIO_BUCKET=openfarm
# Host port for the MinIO console (dev compose only; container stays 9001)
MINIO_CONSOLE_PORT=9001
# Dev: localhost:9000 · Prod: your-domain.com/storage (Caddy strips /storage
# before proxying to MinIO - verify presigned upload URLs after deploy)
MINIO_PUBLIC_ENDPOINT=localhost:9000

# --- NextAuth (apps/web) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional demo login (Credentials provider id: demo). Set BOTH to true to
# show the demo button and accept sign-in. Leave false in production unless
# you intentionally want a shared demo account.
ENABLE_DEMO_LOGIN=false
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# --- OpenFarm JWT ---
OPENFARM_JWT_SECRET=change-me-to-a-random-64-char-string

# --- Public URLs (browser-side) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_TITILER_URL=http://localhost:8080
# Where the browser fetches scouting photos. Baked in at build time, so a
# change here needs `up -d --build web`, not just a restart.
# Prod: https://your-domain.com/storage/openfarm
NEXT_PUBLIC_MINIO_URL=http://localhost:9000/openfarm
NEXT_PUBLIC_PROTOMAPS_URL=http://localhost:9000/openfarm/basemap
TITILER_PUBLIC_URL=http://localhost:8080

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- STAC (Processor) ---
STAC_API_URL=https://earth-search.aws.element84.com/v1

# --- Soil Data ---
SOILGRIDS_WCS_BASE_URL=https://maps.isric.org/mapserv
POLARIS_S3_BUCKET=polaris-soil-data
SOIL_FETCH_TIMEOUT_SECONDS=60
SOIL_FETCH_MAX_WORKERS=12
SOIL_SOURCE_PRIORITY=auto

# Concurrent Sentinel scene download+process threads inside one ingest job.
# Independent of Celery --concurrency (compose ingest default is 4). Each
# thread uses its own DB session. Lower this if Postgres or outbound HTTP
# is saturated (try 8); raise only if the machine has headroom.
INGEST_SCENE_MAX_WORKERS=16

# --- Email (Resend) ---
RESEND_API_KEY=resend_api_key
RESEND_FROM_EMAIL=OpenFarm <noreply@openfarm.earth>
APP_URL=http://localhost:3000

# --- Production only ---
# Hostname Caddy serves + requests a Let's Encrypt certificate for.
# Leave unset in dev (Caddy falls back to localhost, no cert issued).
# DOMAIN=your-domain.com
# Public origin of this deployment. Canonical URLs, hreflang, sitemap,
# robots.txt, Open Graph tags and structured data are all built from it.
# Set this in production: leaving it at localhost publishes localhost
# canonicals. Baked in at build time, so changing it needs a web rebuild.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Glossary plate images on OSS (scripts/upload_to_oss.py --prefix web/glossary/)
NEXT_PUBLIC_GLOSSARY_ASSET_BASE=https://agric-dev.oss-cn-beijing.aliyuncs.com/web/glossary

# --- CloudAMQP (RabbitMQ task bus; never commit real URL) ---
CLOUDAMQP_URL=amqps://user:password@host/vhost
CLOUDAMQP_DOWNLOAD_QUEUE=openfarm_download
CLOUDAMQP_PROCESS_QUEUE=openfarm_process
# One-release aliases (optional; preferred names above):
# CLOUDAMQP_TASK_QUEUE=openfarm_download
# CLOUDAMQP_RESULT_QUEUE=openfarm_process
# Optional: if CLOUDAMQP_URL missing, API falls back to direct Celery (default off)
MQ_FALLBACK_CELERY=0
