# ============================================
# agric-satellite-analysis / 农业卫星分析
# Environment Variables
# Copy to .env and fill in values. Never commit .env.
# Based on the agric-satellite-analysis project (derived from OpenFarm)
# ============================================

# --- Postgres ---
POSTGRES_USER=openfarm
POSTGRES_PASSWORD=openfarm_dev
POSTGRES_DB=openfarm
DATABASE_URL=postgresql+asyncpg://openfarm:openfarm_dev@db:5432/openfarm
# Sync URL for Alembic migrations
DATABASE_URL_SYNC=postgresql://openfarm:openfarm_dev@db:5432/openfarm

# --- Redis ---
# API host: local compose redis service (or API-machine Redis). Never expose to download hosts.
# Download host: MUST be localhost only for Celery, e.g. redis://127.0.0.1:6379/0
REDIS_URL=redis://redis:6379/0

# Celery Redis broker/backend sockets (ingest, storage, beat, api, mq_consumer).
# Kombu otherwise leaves socket_timeout unset, so a stale long-lived connection
# can stall restore_visible / health-check PING while a fresh PING still works.
# Times are seconds. CONNECTION_MAX_RETRIES=0 means retry reconnects forever.
CELERY_BROKER_VISIBILITY_TIMEOUT=7200
CELERY_REDIS_SOCKET_TIMEOUT=5
CELERY_REDIS_SOCKET_CONNECT_TIMEOUT=5
CELERY_REDIS_SOCKET_KEEPALIVE=true
CELERY_REDIS_RETRY_ON_TIMEOUT=true
CELERY_REDIS_HEALTH_CHECK_INTERVAL=25
CELERY_BROKER_CONNECTION_MAX_RETRIES=0


# --- Object storage backend (Aliyun OSS) ---
# Aliyun OSS is used for all uploads (scene JSON, photos, and optional rasters).
# Never commit real OSS secrets — wire via host env / private .env.
STORAGE_BACKEND=oss

# --- Aliyun OSS (default primary backend + parcel products) ---
# Leave secrets empty in this example; load from a private env file at runtime.
OSS_REGION=oss-cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=agric-dev
# Fixed S1/S2 parcel product JSON directory
OSS_PREFIX=s1s2_parcel/json/

# --- NextAuth (agric-satellite-analysis-web) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional demo login (Credentials provider id: demo). Set BOTH to true to
# show the demo button and accept sign-in. Leave false in production unless
# you intentionally want a shared demo account.
ENABLE_DEMO_LOGIN=false
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# --- agric-satellite-analysis JWT ---
OPENFARM_JWT_SECRET=change-me-to-a-random-64-char-string

# --- Public URLs (browser-side) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
# Where the browser fetches scouting photos. Baked in at build time, so a
# change here needs `up -d --build web`, not just a restart.
# Set this to the public Aliyun OSS URL for the basemap when enabled.
NEXT_PUBLIC_PROTOMAPS_URL=
# Public virtual-hosted OSS origin used to display uploaded scouting photos.
NEXT_PUBLIC_OSS_URL=https://agric-dev.oss-cn-beijing.aliyuncs.com

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- STAC (Processor) ---
# Optical S2 (Element84 earth-search)
STAC_API_URL=https://earth-search.aws.element84.com/v1
# Sentinel-1 GRD: Microsoft Planetary Computer (Azure Blob + SAS via
# planetary_computer). No AWS requester-pays keys needed for this path.
# S1_STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# --- Soil Data ---
SOILGRIDS_WCS_BASE_URL=https://maps.isric.org/mapserv
POLARIS_S3_BUCKET=polaris-soil-data
SOIL_FETCH_TIMEOUT_SECONDS=60
SOIL_FETCH_MAX_WORKERS=12
SOIL_SOURCE_PRIORITY=auto

# Concurrent Sentinel scene download+process threads inside one ingest job.
# Independent of Celery --concurrency (compose ingest default is 4). Each
# thread uses its own DB session. Lower this if Postgres or outbound HTTP
# is saturated (try 8); raise only if the machine has headroom.
INGEST_SCENE_MAX_WORKERS=16
# Concurrent windowed band reads inside one scene (S2 multi-band / S1 VV+VH).
# Nested under INGEST_SCENE_MAX_WORKERS. This value is the process-wide GDAL
# cap (semaphore). Per-scene threads are min(n_bands, cap, (cap*2)//scene_workers)
# so 8 scene workers still overlap several S2 bands instead of going serial.
# Default 16. Lower to 8 if outbound HTTP or GDAL RAM is saturated.
INGEST_BAND_MAX_WORKERS=16

# Index COG/TIF uploads. Unset = agri fields skip rasters (lonlat-direct);
# legacy fields may still write optional index rasters to OSS.
# 0 = never upload index TIFs. 1 = always upload (agri opt-in; storage-heavy).
WRITE_INDEX_COGS=
# Compact lonlat_v1 scene JSON under OSS_PREFIX (not rasters). Default on.
UPLOAD_SCENE_JSON=1

# Optional UnCRtainTS parcel-window cloud removal after agri optical ingest.
# Default off. Does not overwrite raw S2 products. Only quality=good feeds
# official drought / timeseries / land metrics. See docs/decloud-uncrtaints.md.
DECLOUD_ENABLED=0
DECLOUD_MODE=batch
DECLOUD_CLOUD_MIN_PCT=30
DECLOUD_STAC_CLOUD_MAX_PCT=100
DECLOUD_BACKEND=uncrtaints
DECLOUD_INPUT_T=3
DECLOUD_USE_SAR=1
DECLOUD_CACHE_DIR=
UNCRTAINTS_CHECKPOINT_DIR=
UNCRTAINTS_HOME=
UNCRTAINTS_CHECKPOINT_NAME=diagonal_1

# --- Email (Resend) ---
RESEND_API_KEY=resend_api_key
RESEND_FROM_EMAIL=agric-satellite-analysis <noreply@openfarm.earth>
APP_URL=http://localhost:3000

# --- Production only ---
# Hostname Caddy serves + requests a Let's Encrypt certificate for.
# Leave unset in dev (Caddy falls back to localhost, no cert issued).
# DOMAIN=your-domain.com
# Public origin of this deployment. Canonical URLs, hreflang, sitemap,
# robots.txt, Open Graph tags and structured data are all built from it.
# Set this in production: leaving it at localhost publishes localhost
# canonicals. Baked in at build time, so changing it needs a web rebuild.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Glossary plate images on OSS (scripts/upload_to_oss.py --prefix web/glossary/)
NEXT_PUBLIC_GLOSSARY_ASSET_BASE=https://agric-dev.oss-cn-beijing.aliyuncs.com/web/glossary

# --- CloudAMQP (RabbitMQ task bus; never commit real URL) ---
CLOUDAMQP_URL=amqps://user:password@host/vhost
CLOUDAMQP_DOWNLOAD_QUEUE=openfarm_download
CLOUDAMQP_PROCESS_QUEUE=openfarm_process
# One-release aliases (optional; preferred names above):
# CLOUDAMQP_TASK_QUEUE=openfarm_download
# CLOUDAMQP_RESULT_QUEUE=openfarm_process
# Optional: if CLOUDAMQP_URL missing, API falls back to direct Celery (default off)
MQ_FALLBACK_CELERY=0

# --- Alibaba Bailian LLM (season growth report AI sections) ---
# Never commit real keys. Leave empty to generate PDF facts-only.
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://llm-7cudikcfvgf9l1hy.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.7-flash

# --- cdfinance / 中和农信 soil NPK + site admission ---
# Test: https://joint-venture-test.cdfinance.com.cn/agric-api
# Prod:  https://joint-venture.cdfinance.com.cn/agric-api
# Shared by analyzeSoilV2 and groupSiteAdmission. Never commit JWTs.
# Bearer JWT is supplied per-request by the UI (never commit tokens).
CDFINANCE_SOIL_BASE_URL=https://joint-venture.cdfinance.com.cn/agric-api
CDFINANCE_APP_KEY=83f94deg-k4d3-5gc4-0a6d-fd995a6f03g5
CDFINANCE_CHANNEL_NET=H5
CDFINANCE_HR_BASE_ID=38
CDFINANCE_ORIGIN=https://joint-venture.cdfinance.com.cn
CDFINANCE_REFERER=https://joint-venture.cdfinance.com.cn/
CDFINANCE_SOIL_TIMEOUT_SECONDS=60


# --- Download-host isolation / HTTP claim (see docs/design/download-host-no-direct-pg-redis.md) ---
# WORK_QUEUE_MODE:
#   legacy — CloudAMQP/Celery only (safe default; current prod download path)
#   claim  — Postgres work_items + HTTP claim only (no MQ publish for gated types)
#   dual   — insert work_items AND keep MQ publish (API transition; keep download on legacy)
# Cutover runbook: docs/design/work-queue-cutover.md
# dual on download must NOT run claim agent (double-dispatch). Claim agent = claim only.
WORK_QUEUE_MODE=legacy
# Optional comma list for claim agent type filter (default: all claimable types)
# WORK_CLAIM_TYPES=assessment_report,season_growth_report,field_bootstrap,satellite_analysis,weather_backfill,soil_fetch
# Shared secret for /v1/internal/* (API validates; download agent sends Bearer).
# Generate a long random string; never commit the real value.
INTERNAL_API_TOKEN=
# API lease defaults (API process)
WORK_LEASE_SECONDS=600
WORK_CLAIM_DEFAULT_LIMIT=1
WORK_REAPER_ON_CLAIM=1
#
# Download machine only (docker-compose.download-machine.yml):
# REDIS_URL must be localhost Celery broker — do NOT point at API Redis.
# REDIS_URL=redis://127.0.0.1:6379/0
# API_BASE_URL=http://81.71.128.251:8000
# When API_BASE_URL + INTERNAL_API_TOKEN are set, download workers use internal
# HTTP for field resolve / agri scene dates / land meta / job get (D2).
# If unset, SyncSession DATABASE_URL reads remain the legacy fallback.
# WORKER_ID=download-1
# WORK_CLAIM_INTERVAL_SEC=4
# Enable claim consumer: WORK_QUEUE_MODE=claim (optional; leave legacy until cutover)
#
# D3 writes (keep PG until intentional cutover):
# INGEST_PG_WRITES=1          # default — download may still SyncSession-write
# INGEST_PG_WRITES=0          # force HTTP writes (patch jobs / results/apply / work complete)
# INGEST_PG_READS=0           # optional; defaults to INGEST_PG_WRITES. When 0 + API_BASE_URL set,
#                             # assessment/season loaders and weather/soil geom use Internal HTTP only.
# After D4.1, download workers can leave DATABASE_URL unset when API_BASE_URL+token are set
# (claim + assessment/season-growth + weather/soil bootstrap). Unset DATABASE_URL* on download
# once verification passes; API host keeps Postgres.
# INGEST_HTTP_WRITES=1        # canary HTTP writes while keeping PG path (legacy/dual)
# WORK_QUEUE_MODE=claim also enables HTTP writes when API_BASE_URL is set.
# Do NOT set download WORK_QUEUE_MODE=claim in prod until cutover checklist passes.
