#!/bin/sh

echo "Running pre-commit checks..."

# ── API: ruff check + format ────────────────────────────────────────
CHANGED_API=$(git diff --cached --name-only -- 'services/api/')
if [ -n "$CHANGED_API" ]; then
  echo "▸ API: ruff check"
  cd services/api
  ruff check . || python3 -m ruff check . || { echo "FAIL: API ruff check failed"; exit 1; }

  echo "▸ API: ruff format"
  ruff format --check . || python3 -m ruff format --check . || { echo "FAIL: API ruff format failed"; exit 1; }
  cd ../..
fi

# ── Config: every documented variable reaches its consumer ──────────
CHANGED_ENV=$(git diff --cached --name-only -- '.env.example' 'docker-compose*.yml' 'services/api/app/core/config.py' 'services/api/' 'deploy/')
if [ -n "$CHANGED_ENV" ]; then
  echo "▸ Config: env parity"
  python3 scripts/check-env-parity.py || { echo "FAIL: env parity check failed"; exit 1; }
fi

echo "OK: All checks passed"
