# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change_me
PGDATABASE=postgres

# 可选：OSS 凭证文件路径（默认 /home/box/.config/aliyun/oss.env）
# 文件内需含：OSS_REGION, OSS_ENDPOINT, OSS_ACCESS_KEY_ID, OSS_ACCESS_KEY_SECRET, OSS_BUCKET
OSS_ENV=/home/box/.config/aliyun/oss.env

# 可选：OSS 对象前缀（也可由 CLI --prefix 覆盖）
OSS_PREFIX=s1s2_parcel/json/
