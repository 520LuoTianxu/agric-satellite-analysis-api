# ─────────────────────────────────────────────────────────────────────────────
# agric-satellite-analysis - Caddy Reverse Proxy Configuration
#
# Replace {$DOMAIN} with your actual domain, or set DOMAIN env var.
# Caddy auto-provisions Let's Encrypt SSL certificates.
# ─────────────────────────────────────────────────────────────────────────────

# www → apex redirect (Caddy provisions a cert for www automatically;
# requires a DNS record for www pointing at this server)
www.{$DOMAIN:localhost} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN:localhost} {
	# ── API routes → FastAPI ─────────────────────────────────────────
	handle /satellite-api {
		redir /satellite-api/ permanent
	}

	# The frontend uses one stable gateway prefix; restore FastAPI's /v1 prefix upstream.
	handle_path /satellite-api/* {
		rewrite * /v1{uri}
		reverse_proxy api:8000
	}

	handle /v1/* {
		reverse_proxy api:8000
	}

	handle /docs* {
		reverse_proxy api:8000
	}

	handle /openapi.json {
		reverse_proxy api:8000
	}

	handle /healthz {
		reverse_proxy api:8000
	}

	# ── Everything else → static frontend ────────────────────────────
	handle {
		reverse_proxy web:80
	}

	# Compression
	encode gzip zstd

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Logging
	log {
		output file /data/access.log {
			roll_size 100mb
			roll_keep 5
		}
	}
}
