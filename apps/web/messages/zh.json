    "seo": {
        "title": "农业卫星分析：开源作物智能平台（基于 OpenFarm）",
        "description": "开源作物智能：将 Sentinel-2 影像、气象与土壤融合为可解释的逐地块洞察。可自行部署，BSD-3-Clause，无需 API 密钥。",
        "longDescription": "农业卫星分析是开源作物智能平台（基于 OpenFarm）。它将 Sentinel-2 卫星影像、逐日气象和土壤数据融合为逐地块洞察，并展示每条预警背后的证据：哪个指数发生了变化、时间窗口有多长，以及能够解释它的环境条件。",
        "category": "作物智能与遥感",
        "featureList": "Sentinel-2 植被指数，10 m 分辨率 | 每个地块回填 24 个月历史 | 逐日气象历史与 7 日预报 | 土层特性深至 200 cm | 可解释的异常预警 | 基于影像的地块边界检测 | 使用 Docker Compose 自行部署 | 多租户与基于角色的访问控制",
        "ogHeadline": "了解地块正在发生什么，以及为什么",
        "ogSubhead": "来自卫星、气象与土壤的开源作物智能",
        "ogAlt": "农业卫星分析，来自卫星、气象与土壤的开源作物智能（基于 OpenFarm）",
        "datasetDesc": {
            "sentinel": "来自欧洲航天局 Sentinel-2 任务的多光谱光学影像：13 个波段，分辨率 10 至 60 m，赤道附近五日重访。农业卫星分析根据红光、近红外和短波红外波段，按景计算 NDVI、EVI、SAVI 和 NDWI，并为每条地块边界回填 24 个月历史。",
            "weather": "汇集各国气象部门的逐日、逐时气象历史与预报。农业卫星分析从中读取气温、降水、蒸散、风速和土壤湿度，并为每个地块计算生长度日、参考蒸散、水分平衡和干旱指数。",
            "soil": "基于土壤剖面观测与环境协变量汇编、以 250 m 分辨率预测的全球土壤特性图。农业卫星分析按深度层读取质地、pH、有机碳、阳离子交换量、容重和有效水容量，直至 200 cm。"
        }
    },
    "faq": {
        "tag": "问题",
        "title": "部署前先看这些答案",
        "desc": "在自己的地块上运行农业卫星分析（基于 OpenFarm）之前，人们常问的问题。",
        "what": {
            "q": "什么是农业卫星分析？",
            "a": "农业卫星分析是开源作物智能平台（基于 OpenFarm）。它将 Sentinel-2 卫星影像、逐日气象和土壤数据融合为逐地块洞察，并展示每条预警背后的证据：哪个指数发生了变化、时间窗口有多长，以及能够解释它的环境条件。"
        },
        "stress": {
            "q": "农业卫星分析如何检测作物胁迫？",
            "a": "它将每一景新影像与该地块自身的历史进行比较，而不是使用固定阈值。当指数下降时，农业卫星分析会读取同一时间窗口的降雨、蒸散和土壤水分平衡，因此预警会告诉你这是否是水分胁迫，而不仅仅是「有东西变了」。"
        },
        "satellite": {
            "q": "农业卫星分析使用哪些卫星数据？",
            "a": "Sentinel-2，欧洲航天局的 10 m 多光谱任务，通过公开的 Element 84 Earth Search 目录检索。农业卫星分析按景计算 NDVI、EVI、SAVI 和 NDWI，跳过超过云量阈值的影像，并在你画下边界时回填 24 个月历史。"
        },
        "soil": {
            "q": "农业卫星分析使用哪些土壤数据？",
            "a": "ISRIC SoilGrids 在全球以 250 m 提供质地、pH、有机碳、CEC 和水力特性，POLARIS 在美国提供 30 m 覆盖。地块边界一经存在，就会自动拉取直至 200 cm 的每一层。"
        },
        "free": {
            "q": "农业卫星分析免费吗？",
            "a": "是的。农业卫星分析采用 BSD-3-Clause 许可，无席位限制、无按公顷计费、无需供应商账号。你可以在自己的服务器上免费运行完整技术栈，也可以先试用托管演示。无需第三方 API 密钥，底图也不需要。"
        },
        "selfhost": {
            "q": "我可以自行部署农业卫星分析吗？",
            "a": "可以，这就是默认方式。Next.js、FastAPI、PostGIS、MinIO 和 TiTiler 通过一份 Docker Compose 文件即可在任意 VPS 上启动，Terraform 还可以帮你配置机器。在线演示运行在免费档 2 OCPU、12 GB 实例上，整套技术栈都能放下。"
        },
        "crops": {
            "q": "农业卫星分析支持哪些作物？",
            "a": "谷物、豆类、油料、蔬菜、纤维作物和多年生作物各自带有适宜性配置：温度、降雨、pH、排水和盐分区间，会对照你地块真实的土壤与气候打分。配置是仓库中的普通数据，添加一种作物只需提交 pull request。"
        },
        "updates": {
            "q": "数据更新有多频繁？",
            "a": "Sentinel-2 对大多数地块每隔几天重访一次，农业卫星分析会根据最新可用影像每周重新计算指数。气象每天刷新，并附带 7 日预报。土壤每个地块只获取一次，因为土壤特性的变化以十年计，而不是以周计。"
        }
    },
